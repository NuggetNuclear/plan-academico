# Sincronización opcional con Google (Firebase). Copia este archivo como .env.local
# y completa los valores de "Configuración del SDK" de tu app web en Firebase.
# No son secretos: la seguridad la dan las reglas de firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
